<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GasApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GasApp"
    xmlns:views="clr-namespace:GasApp.Views"
    Title="GasApp"
    FlyoutBackgroundColor="{AppThemeBinding Light=White, Dark=#0A0A0A}"
    FlyoutWidth="290"
    Shell.BackgroundColor="#111111"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.NavBarHasShadow="True"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1D}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light=#6D28D9, Dark=#D4AF37}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#6D28D9, Dark=#D4AF37}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}">

    <!-- Encabezado del menú lateral -->
    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <Grid HeightRequest="180" Padding="20,36,20,18">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#111111" Offset="0.0" />
                        <GradientStop Color="#3B1F5C" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <VerticalStackLayout Spacing="8" VerticalOptions="End">
                    <Border WidthRequest="56"
                            HeightRequest="56"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#D4AF37"
                            HorizontalOptions="Start">
                        <Label Text="⛽"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="GasApp"
                           FontSize="22"
                           FontFamily="OpenSansSemibold"
                           TextColor="White" />
                    <Label Text="Carga gasolina y gana puntos"
                           FontSize="13"
                           TextColor="#CFC6DD" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>

    <!-- Plantilla de cada opción del menú lateral -->
    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="16"
                  Padding="20,14"
                  Margin="10,2">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAF3DC, Dark=#3A3214}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <Image Source="{Binding FlyoutIcon}"
                       WidthRequest="22"
                       HeightRequest="22"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="15"
                       FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light=#111111, Dark=#E4E4E7}"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- Pestañas inferiores (se llenan en AppShell.xaml.cs → BottomMenu) -->
    <FlyoutItem x:Name="menutabs"
                Title="Inicio"
                Icon="casini.png" />

    <!-- Pie del menú lateral -->
    <Shell.FlyoutFooterTemplate>
        <DataTemplate>
            <VerticalStackLayout Padding="20,12,20,24" Spacing="12">
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light=#E6E3EC, Dark=#35303D}" />
                <Button Text="Cerrar sesión"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        HeightRequest="48"
                        CornerRadius="14"
                        TextColor="#DC2626"
                        BackgroundColor="{AppThemeBinding Light=#FDECEC, Dark=#3A1818}"
                        Clicked="Button_Clicked" />
                <Label Text="Versión 1.0"
                       FontSize="12"
                       TextColor="#9CA3AF"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>

</Shell>
