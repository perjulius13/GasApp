<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GasApp.Models"
             x:Class="GasApp.Views.HomeView"
             Title="Inicio"
             BackgroundColor="{AppThemeBinding Light={StaticResource HomeFondoClaro}, Dark={StaticResource HomeFondoOscuro}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Paleta: negro (principal), morado y dorado (secundarios) -->
            <Color x:Key="HomeAcento">#D4AF37</Color>
            <Color x:Key="HomeNegro">#111111</Color>
            <Color x:Key="HomeMoradoOscuro">#3B1F5C</Color>
            <Color x:Key="HomeFondoClaro">#F6F5F8</Color>
            <Color x:Key="HomeFondoOscuro">#0A0A0A</Color>
            <Color x:Key="HomeTarjetaClaro">#FFFFFF</Color>
            <Color x:Key="HomeTarjetaOscuro">#1A1A1D</Color>
            <Color x:Key="HomeTextoSecundario">#6B7280</Color>
            <Color x:Key="HomeVerde">#16A34A</Color>

            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HomeTarjetaClaro}, Dark={StaticResource HomeTarjetaOscuro}}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="Black" Opacity="0.07" Radius="12" Offset="0,4" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TituloSeccion" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeNegro}, Dark=White}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="EnlaceSeccion" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6D28D9, Dark=#B794F6}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <Style x:Key="TextoPrincipal" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeNegro}, Dark=White}" />
            </Style>

            <Style x:Key="TextoSecundario" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource HomeTextoSecundario}" />
            </Style>

            <!-- Botón cuadrado de acceso rápido -->
            <Style x:Key="AccesoRapido" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HomeTarjetaClaro}, Dark={StaticResource HomeTarjetaOscuro}}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="6,14" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccesoIcono" TargetType="Border">
                <Setter Property="WidthRequest" Value="46" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAF3DC, Dark=#3A3214}" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="AccesoTexto" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HomeNegro}, Dark=#D4D4D8}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,28" Spacing="22">

            <!-- Saludo -->
            <VerticalStackLayout Spacing="2">
                <Label x:Name="SaludoLabel"
                       Text="¡Hola, Usuario! 👋"
                       FontSize="24"
                       FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light={StaticResource HomeNegro}, Dark=White}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="¿Listo para tu próxima carga?"
                       Style="{StaticResource TextoSecundario}"
                       FontSize="14" />
            </VerticalStackLayout>

            <!-- Tarjeta de puntos -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource HomeNegro}" Offset="0.0" />
                        <GradientStop Color="{StaticResource HomeMoradoOscuro}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.18" Radius="18" Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Tus puntos" FontSize="13" TextColor="#CFC6DD" />
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="PuntosLabel"
                                       Text="1,250"
                                       FontSize="36"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White" />
                                <Label Text="pts"
                                       FontSize="16"
                                       TextColor="#CFC6DD"
                                       VerticalOptions="End"
                                       Margin="0,0,0,7" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Insignia de nivel -->
                        <Border Grid.Column="1"
                                BackgroundColor="#33FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,5"
                                VerticalOptions="Start">
                            <Label x:Name="NivelLabel"
                                   Text="⭐ Nivel Oro"
                                   FontSize="12"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <!-- Progreso al siguiente nivel -->
                    <VerticalStackLayout Spacing="6">
                        <ProgressBar x:Name="NivelProgress"
                                     Progress="0.62"
                                     ProgressColor="{StaticResource HomeAcento}"
                                     BackgroundColor="#33FFFFFF"
                                     HeightRequest="6" />
                        <Label x:Name="SiguienteNivelLabel"
                               Text="Te faltan 750 pts para Nivel Platino"
                               FontSize="12"
                               TextColor="#CFC6DD" />
                    </VerticalStackLayout>

                    <Button Text="Mostrar mi código"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            HeightRequest="46"
                            CornerRadius="14"
                            TextColor="#111111"
                            BackgroundColor="{StaticResource HomeAcento}"
                            Clicked="OnMostrarCodigoClicked"
                            SemanticProperties.Hint="Muestra tu código para acumular puntos en la estación" />
                </VerticalStackLayout>
            </Border>

            <!-- Accesos rápidos -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource AccesoRapido}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMapaTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Border Style="{StaticResource AccesoIcono}">
                            <Label Text="📍" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Mapa" Style="{StaticResource AccesoTexto}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AccesoRapido}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecompensasTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Border Style="{StaticResource AccesoIcono}">
                            <Label Text="🎁" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Canjear" Style="{StaticResource AccesoTexto}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AccesoRapido}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReviewsTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Border Style="{StaticResource AccesoIcono}">
                            <Label Text="💬" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Reseñas" Style="{StaticResource AccesoTexto}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource AccesoRapido}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAyudaTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Border Style="{StaticResource AccesoIcono}">
                            <Label Text="❓" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Ayuda" Style="{StaticResource AccesoTexto}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Promoción -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light=#FAF3DC, Dark=#3A3214}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="Puntos dobles este fin de semana"
                               FontSize="15"
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light=#6B5310, Dark=#E8CB6A}" />
                        <Label Text="Carga Premium en estaciones participantes y gana el doble."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6B5310, Dark=#F2E3B3}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="🔥"
                           FontSize="34"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Estaciones cercanas -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Estaciones cercanas" Style="{StaticResource TituloSeccion}" />
                    <Label Grid.Column="1" Text="Ver mapa" Style="{StaticResource EnlaceSeccion}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMapaTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout x:Name="EstacionesLayout" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:EstacionResumen">
                            <Border Style="{StaticResource Tarjeta}">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="10">

                                    <Border Grid.RowSpan="2"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light=#F1ECF8, Dark=#262130}"
                                            VerticalOptions="Start">
                                        <Label Text="⛽" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Nombre}" Style="{StaticResource TextoPrincipal}" />
                                        <Label Text="{Binding Direccion}" Style="{StaticResource TextoSecundario}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding Distancia}"
                                               FontSize="13"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light=#6D28D9, Dark=#B794F6}"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding Calificacion, StringFormat='★ {0}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource HomeTextoSecundario}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>

                                    <!-- Precios -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="10,4"
                                                BackgroundColor="{AppThemeBinding Light=#E7F6EC, Dark=#14301F}">
                                            <Label FontSize="12" TextColor="{StaticResource HomeVerde}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Magna " />
                                                        <Span Text="{Binding PrecioMagna}" FontFamily="OpenSansSemibold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Border>
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="10,4"
                                                BackgroundColor="{AppThemeBinding Light=#FDECEC, Dark=#3A1818}">
                                            <Label FontSize="12" TextColor="#DC2626">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Premium " />
                                                        <Span Text="{Binding PrecioPremium}" FontFamily="OpenSansSemibold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Actividad reciente -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Actividad reciente" Style="{StaticResource TituloSeccion}" />
                    <Label Grid.Column="1" Text="Ver todo" Style="{StaticResource EnlaceSeccion}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVerHistorialTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border Style="{StaticResource Tarjeta}" Padding="16,6">
                    <VerticalStackLayout x:Name="MovimientosLayout">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MovimientoPuntos">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Estacion}" Style="{StaticResource TextoPrincipal}" FontSize="14" />
                                        <Label Style="{StaticResource TextoSecundario}" FontSize="12">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Fecha}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding Detalle}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding Puntos}"
                                           FontSize="15"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource HomeVerde}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
