<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GasApp.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LoginFondoClaro}, Dark={StaticResource LoginFondoOscuro}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Paleta de la pantalla de login -->
            <Color x:Key="LoginAcento">#D4AF37</Color>
            <Color x:Key="LoginAcentoOscuro">#A8861F</Color>
            <Color x:Key="LoginNegro">#111111</Color>
            <Color x:Key="LoginFondoClaro">#F6F5F8</Color>
            <Color x:Key="LoginFondoOscuro">#0A0A0A</Color>
            <Color x:Key="LoginTarjetaClaro">#FFFFFF</Color>
            <Color x:Key="LoginTarjetaOscuro">#1A1A1D</Color>
            <Color x:Key="LoginCampoClaro">#F2F1F5</Color>
            <Color x:Key="LoginCampoOscuro">#262130</Color>
            <Color x:Key="LoginTextoSecundario">#6B7280</Color>

            <!-- Contenedor de cada campo de texto -->
            <Style x:Key="CampoBorde" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E6E3EC, Dark=#35303D}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LoginCampoClaro}, Dark={StaticResource LoginCampoOscuro}}" />
                <Setter Property="Padding" Value="14,2" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <Style x:Key="CampoEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LoginNegro}, Dark=White}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource LoginTextoSecundario}" />
            </Style>

            <Style x:Key="CampoEtiqueta" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LoginNegro}, Dark=#D4D4D8}" />
                <Setter Property="Margin" Value="4,0,0,6" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Encabezado con logo -->
        <Grid Grid.Row="0"
              HeightRequest="260"
              Padding="24,48,24,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource LoginNegro}" Offset="0.0" />
                    <GradientStop Color="#3B1F5C" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Start">
                <Border WidthRequest="84"
                        HeightRequest="84"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource LoginAcento}"
                        StrokeShape="RoundRectangle 24"
                        HorizontalOptions="Center">
                    <Label Text="⛽"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Logotipo de GasApp" />
                </Border>

                <Label Text="GasApp"
                       FontSize="28"
                       FontFamily="OpenSansSemibold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="Carga gasolina y gana puntos"
                       FontSize="14"
                       TextColor="#CFC6DD"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Tarjeta con el formulario (se superpone al encabezado) -->
        <ScrollView Grid.Row="0" Grid.RowSpan="2" Margin="0,200,0,0">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="20">

                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LoginTarjetaClaro}, Dark={StaticResource LoginTarjetaOscuro}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="22,26">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Iniciar sesión"
                                   FontSize="22"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource LoginNegro}, Dark=White}"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="Ingresa con tu cuenta para consultar tus puntos."
                                   FontSize="14"
                                   TextColor="{StaticResource LoginTextoSecundario}" />
                        </VerticalStackLayout>

                        <!-- Usuario -->
                        <VerticalStackLayout>
                            <Label Text="Usuario" Style="{StaticResource CampoEtiqueta}" />
                            <Border Style="{StaticResource CampoBorde}">
                                <Entry x:Name="UsuarioEntry"
                                       Placeholder="Tu nombre de usuario"
                                       Keyboard="Plain"
                                       IsSpellCheckEnabled="False"
                                       IsTextPredictionEnabled="False"
                                       ReturnType="Next"
                                       Style="{StaticResource CampoEntry}"
                                       SemanticProperties.Description="Nombre de usuario"
                                       Completed="OnUsuarioCompleted" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Contraseña -->
                        <VerticalStackLayout>
                            <Label Text="Contraseña" Style="{StaticResource CampoEtiqueta}" />
                            <Border Style="{StaticResource CampoBorde}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry x:Name="ContrasenaEntry"
                                           Grid.Column="0"
                                           Placeholder="••••••••"
                                           IsPassword="True"
                                           ReturnType="Done"
                                           Completed="OnIngresarClicked"
                                           Style="{StaticResource CampoEntry}"
                                           SemanticProperties.Description="Contraseña" />
                                    <Label x:Name="MostrarContrasenaLabel"
                                           Grid.Column="1"
                                           Text="Mostrar"
                                           FontSize="13"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light=#6D28D9, Dark=#B794F6}"
                                           VerticalOptions="Center"
                                           Padding="8,0,0,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMostrarContrasenaTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Recordarme / Olvidé contraseña -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <CheckBox x:Name="RecordarmeCheck"
                                      Grid.Column="0"
                                      Color="{AppThemeBinding Light=#6D28D9, Dark=#B794F6}"
                                      VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Recordarme"
                                   FontSize="13"
                                   TextColor="{StaticResource LoginTextoSecundario}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="¿Olvidaste tu contraseña?"
                                   FontSize="13"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light=#6D28D9, Dark=#B794F6}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOlvideContrasenaTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Mensaje de error (oculto por defecto) -->
                        <Border x:Name="ErrorBorder"
                                IsVisible="False"
                                BackgroundColor="#FDECEC"
                                Stroke="#F5B5B5"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,10">
                            <Label x:Name="ErrorLabel"
                                   FontSize="13"
                                   TextColor="#B42318" />
                        </Border>

                        <!-- Botón principal -->
                        <Grid>
                            <Button x:Name="IngresarButton"
                                    Text="Ingresar"
                                    FontSize="16"
                                    FontFamily="OpenSansSemibold"
                                    HeightRequest="52"
                                    CornerRadius="14"
                                    TextColor="#111111"
                                    BackgroundColor="{StaticResource LoginAcento}"
                                    Clicked="OnIngresarClicked"
                                    SemanticProperties.Hint="Inicia sesión con tu usuario y contraseña" />
                            <ActivityIndicator x:Name="CargandoIndicator"
                                               IsRunning="False"
                                               IsVisible="False"
                                               Color="#111111"
                                               HeightRequest="24"
                                               WidthRequest="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Registro -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="¿No tienes cuenta?"
                           FontSize="14"
                           TextColor="{StaticResource LoginTextoSecundario}" />
                    <Label Text="Regístrate"
                           FontSize="14"
                           FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light=#6D28D9, Dark=#B794F6}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegistrateTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
